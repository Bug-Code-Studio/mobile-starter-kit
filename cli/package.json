{
  "name": "@bugcodestudio/create-app",
  "version": "0.1.2",
  "description": "Create a React Native Expo application from the BugCode Studio starter kit.",
  "type": "module",
  "bin": {
    "create-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsc",
